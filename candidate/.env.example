# ============================================================
# Google Sheets credentials
# ============================================================
# Path to Google service account credentials
Example: ./google-credentials.json
GOOGLE_CREDENTIALS_PATH=

# ============================================================
# Google Sheet IDs
# ============================================================
# Employees sheet
EMPLOYEES_SHEET_ID=your_google_sheet_id
EMPLOYEES_RANGE=employees!A:L

# Projects sheet
PROJECTS_SHEET_ID=your_google_sheet_id
PROJECTS_RANGE=projects!A:J

# Allocations sheet
ALLOCATIONS_SHEET_ID=your_google_sheet_id
ALLOCATIONS_RANGE=allocations!A:I

# ============================================================
# PostgreSQL — provide either DATABASE_URL or individual vars
# ============================================================
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# ============================================================
# Pipeline options
# ============================================================
# true  -> validate only (no DB write)
# false -> run full pipeline
DRY_RUN=false
